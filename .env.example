# ReelTune — Environment Variables
# Copy to apps/api/.env and fill in. NEVER commit the filled version.

# ─── CORE ───
NODE_ENV=development
PORT=3000
API_BASE_URL=http://localhost:3000

# ─── DATABASE ───
DATABASE_URL="postgresql://postgres:password@localhost:5432/reeltune?schema=public"

# ─── REDIS (BullMQ + cache) ───
REDIS_URL="redis://localhost:6379"

# ─── SUPABASE AUTH ───
# Dashboard → Project Settings → API
SUPABASE_URL="https://xxxxx.supabase.co"
SUPABASE_ANON_KEY=""          # safe for client
SUPABASE_SERVICE_ROLE_KEY=""  # SERVER ONLY — never ship to mobile/web
SUPABASE_JWT_SECRET=""        # for verifying tokens in NestJS guard

# ─── TOKEN ENCRYPTION ───
# 32-byte key for encrypting OAuth tokens at rest
# Generate: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=""

# ─── SPOTIFY ───
# developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=""
SPOTIFY_CLIENT_SECRET=""
SPOTIFY_REDIRECT_URI="http://localhost:3000/api/v1/integrations/spotify/callback"
SPOTIFY_SCOPES="playlist-modify-private playlist-modify-public playlist-read-private user-read-email"

# ─── YOUTUBE / GOOGLE ───
# console.cloud.google.com → enable YouTube Data API v3
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/v1/integrations/youtube/callback"
YOUTUBE_API_KEY=""

# ─── SONG RECOGNITION ───
# Pick one. AudD is simplest to start; ACRCloud is more accurate at scale.
RECOGNITION_PROVIDER="audd"        # audd | acrcloud
AUDD_API_TOKEN=""
ACRCLOUD_HOST=""
ACRCLOUD_ACCESS_KEY=""
ACRCLOUD_ACCESS_SECRET=""
RECOGNITION_TIMEOUT_MS=15000
RECOGNITION_CONFIDENCE_THRESHOLD=0.70

# ─── STORAGE ───
SUPABASE_STORAGE_BUCKET="reeltune-assets"

# ─── MONITORING ───
SENTRY_DSN=""
POSTHOG_API_KEY=""
POSTHOG_HOST="https://app.posthog.com"

# ─── DEEP LINKS ───
MOBILE_DEEP_LINK_SCHEME="reeltune"
WEB_APP_URL="http://localhost:3001"

# ─── RATE LIMITING ───
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100


# ════════════════════════════════════════════════
# MOBILE — apps/mobile/.env
# Only EXPO_PUBLIC_* vars reach the app bundle.
# Never put a secret here — it ships in the binary.
# ════════════════════════════════════════════════
# EXPO_PUBLIC_API_URL="http://localhost:3000/api/v1"
# EXPO_PUBLIC_SUPABASE_URL="https://xxxxx.supabase.co"
# EXPO_PUBLIC_SUPABASE_ANON_KEY=""
# EXPO_PUBLIC_POSTHOG_KEY=""

# ════════════════════════════════════════════════
# WEB — apps/web/.env.local
# ════════════════════════════════════════════════
# NEXT_PUBLIC_API_URL="http://localhost:3000/api/v1"
# NEXT_PUBLIC_SUPABASE_URL="https://xxxxx.supabase.co"
# NEXT_PUBLIC_SUPABASE_ANON_KEY=""
