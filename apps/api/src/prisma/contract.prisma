// use prisma-8

model User {
  id                String             @id @default(uuid())
  email             String             @unique
  displayName       String?
  avatarUrl         String?
  createdAt         TimestamptzString  @default(now())
  updatedAt         temporal.updatedAtString()
  
  // Relations
  savedSongs        SavedSong[]
  playlists         Playlist[]
  connectedAccounts ConnectedAccount[]
}

model Song {
  id          String         @id @default(uuid())
  title       String
  artists     String[]
  album       String
  artwork     String
  duration    Int            // milliseconds
  isrc        String?
  spotifyId   String?        @unique
  youtubeId   String?        @unique
  metadata    Json?
  
  // Relations
  savedBy     SavedSong[]
  playlists   PlaylistSong[]
}

model SavedSong {
  id        String             @id @default(uuid())
  userId    String
  songId    String
  savedAt   TimestamptzString  @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  song      Song     @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@unique([userId, songId])
}

model Playlist {
  id          String             @id @default(uuid())
  userId      String
  name        String
  description String?
  isPrivate   Boolean            @default(false)
  createdAt   TimestamptzString  @default(now())
  updatedAt   temporal.updatedAtString()

  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  songs       PlaylistSong[]
}

model PlaylistSong {
  id         String             @id @default(uuid())
  playlistId String
  songId     String
  position   Int
  addedAt    TimestamptzString  @default(now())

  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  song       Song     @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@unique([playlistId, songId])
}

model ConnectedAccount {
  id                String             @id @default(uuid())
  userId            String
  provider          String    // 'spotify' | 'youtube'
  providerAccountId String
  accessToken       String    // We'll store encrypted tokens here
  refreshToken      String?
  expiresAt         TimestamptzString?
  connectedAt       TimestamptzString  @default(now())

  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
}
